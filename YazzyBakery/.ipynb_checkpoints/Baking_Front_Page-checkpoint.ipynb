{
 "cells": [
  {
   "cell_type": "raw",
   "id": "e0cb84ac-c607-43f1-81d3-28540488c0a8",
   "metadata": {},
   "source": [
    "---\n",
    "author: \n",
    "    - name: Yasmeen Rghioui\n",
    "      email: yasmeenr@gwmail.gwu.edu\n",
    "      affiliation:\n",
    "        - name: George Washington University\n",
    "          city: Washington, DC\n",
    "format:\n",
    "    html:\n",
    "        embed-resources: true\n",
    "---\n",
    "\n",
    "<style>\n",
    "  body {\n",
    "    background: #ffcace;\n",
    "    margin: 0;\n",
    "  }\n",
    " /* break out of Quarto's centered content column */\n",
    "  main.content, .page-columns, #quarto-content, #quarto-document-content {\n",
    "    max-width: 100% !important;\n",
    "    width: 100% !important;\n",
    "    padding: 0 !important;\n",
    "    margin: 0 !important;\n",
    "  }\n",
    "  #title-block-header, .quarto-title-block {\n",
    "    display: none;\n",
    "  }\n",
    "  .stage {\n",
    "    position: relative;\n",
    "    width: 100vw;                    /* full viewport width */\n",
    "    margin-left: calc(50% - 50vw);   /* pull back to the true left edge */\n",
    "    display: flex;\n",
    "    flex-direction: column;\n",
    "    align-items: center;\n",
    "    justify-content: center;\n",
    "    min-height: 100vh;\n",
    "    overflow: hidden;\n",
    "    font-family: sans-serif;\n",
    "    background: #ffcace;\n",
    "    color: #a10f18;\n",
    "  }\n",
    "  .rise {\n",
    "    opacity: 0;\n",
    "    transform: translateY(60px);\n",
    "    animation: riseUp 0.8s ease-out forwards;\n",
    "    position: relative;          /* needed for z-index to work */\n",
    "    z-index: 1;                  /* content stays on top */\n",
    "  }\n",
    "  .rise:nth-child(7) { animation-delay: 0.1s; }\n",
    "  .rise:nth-child(8) { animation-delay: 0.3s; }\n",
    "  .rise:nth-child(9) { animation-delay: 0.5s; }\n",
    "  @keyframes riseUp {\n",
    "    to {\n",
    "      opacity: 1;\n",
    "      transform: translateY(0) rotate(var(--tilt, 0deg));\n",
    "    }\n",
    "  }\n",
    "  .welcome-box {\n",
    "    --tilt: -4deg;\n",
    "    border: 4px solid #ffcace;\n",
    "    background: #a10f18;\n",
    "    padding: 20px 40px;\n",
    "    color: white;\n",
    "    font-size: 1em;\n",
    "    font-weight: normal;\n",
    "  }\n",
    "  .rise, .rise * {\n",
    "    -webkit-text-stroke: 1px white;\n",
    "    paint-order: stroke fill;\n",
    "  }\n",
    "  .deco {\n",
    "    position: absolute;\n",
    "    font-size: 5rem;\n",
    "    opacity: 0.9;\n",
    "    z-index: 0;\n",
    "    user-select: none;\n",
    "    pointer-events: none;\n",
    "  }\n",
    "</style>\n",
    "\n",
    "<div class=\"stage\">\n",
    "  <!-- TOP edge, left to right -->\n",
    "  <img class=\"deco\" src=\"cupcake.png\"   style=\"top: -20px;  left: -10px;   width: 200px; transform: rotate(-15deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"swirl2.png\"    style=\"top: 100px;  left: -10px;  width: 200px;  transform: rotate(20deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"macaroon.png\"  style=\"top: 2%;  left: 44%;  width: 180px; transform: rotate(-8deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"lolly.png\"     style=\"top: 5%;  right: 24%; width: 200px;  transform: rotate(15deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"donut.png\"     style=\"top: 3%;  right: 5%;  width: 200px; transform: rotate(18deg);  mix-blend-mode: multiply;\">\n",
    "\n",
    "  <!-- RIGHT edge, top to bottom -->\n",
    "  <img class=\"deco\" src=\"cake.png\"      style=\"top: 28%; right: 3%;  width: 200px; transform: rotate(-12deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"swirl3.png\"    style=\"top: 50%; right: 2%;  width: 200px;  transform: rotate(25deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"eclair.png\"    style=\"top: 70%; right: 4%;  width: 200px; transform: rotate(-18deg); mix-blend-mode: multiply;\">\n",
    "\n",
    "  <!-- BOTTOM edge, right to left -->\n",
    "  <img class=\"deco\" src=\"triangle.png\"  style=\"bottom: 3%; right: 6%;  width: 200px; transform: rotate(10deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"circle.png\"    style=\"bottom: 5%; right: 26%; width: 200px;  transform: rotate(-22deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"bun.png\"       style=\"bottom: 2%; left: 45%;  width: 200px; transform: rotate(8deg);   mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"sticks.png\"    style=\"bottom: -80px; left: 405px;  width: 250px;  transform: rotate(40deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"thing1.png\"    style=\"bottom: -20px; left: 115px;   width: 200px; transform: rotate(75deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"cupcake.png\"   style=\"bottom: -45px;  left: 200px;   width: 200px; transform: rotate(30deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"swirl3.png\"    style=\"bottom: -80px; left: 355px;  width: 200px;  transform: rotate(25deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"triangle2.png\"    style=\"bottom: -80px; left: 520px;  width: 200px;  transform: rotate(45deg);  mix-blend-mode: multiply;\">\n",
    "\n",
    "\n",
    "  <!-- LEFT edge, bottom to top -->\n",
    "  <img class=\"deco\" src=\"circle2.png\"   style=\"top: 500px; left: -10px;  width: 200px;  transform: rotate(-25deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"cake.png\"      style=\"top: 625px; left: -10px;  width: 200px; transform: rotate(-20deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"drink.png\"     style=\"top: 300px; left: 20px;  width: 150px; transform: rotate(40deg);  mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"swirly.png\"    style=\"top: 225px; left: -10px;  width: 200px;  transform: rotate(-10deg); mix-blend-mode: multiply;\">\n",
    "  <img class=\"deco\" src=\"triangle2.png\" style=\"top: 14%; left: 14%; width: 150px;  transform: rotate(22deg);  mix-blend-mode: multiply;\">\n",
    "\n",
    "  <h1 class=\"rise welcome-box\">Welcome</h1>\n",
    "  <p class=\"rise\">This paragraph floats up second.</p>\n",
    "  <button class=\"rise\" style=\"color:#a10f18; background:white; border:2px solid #a10f18;\">And this button arrives last</button>\n",
    "</div>"
   ]
  },
